# Copy this file to .env.local and fill in real values. .env.local is gitignored.
# These are SERVER-ONLY variables. Never prefix them with NEXT_PUBLIC_.

# ── Provider ────────────────────────────────────────────────────────────────
# auto   (default): use Shopify when the three SHOPIFY_* variables below are set,
#                   otherwise use the built-in mock catalogue.
# shopify         : always use Shopify (startup error if configuration is missing).
# mock            : always use the mock catalogue and the mock checkout.
COMMERCE_PROVIDER=auto

# ── Shopify (Dev Dashboard app, client credentials grant) ───────────────────
# Your store's permanent myshopify domain, e.g. my-store.myshopify.com
SHOPIFY_SHOP_DOMAIN=your-store.myshopify.com
# Dev Dashboard → your app → Settings → Credentials
SHOPIFY_CLIENT_ID=replace-with-client-id
SHOPIFY_CLIENT_SECRET=replace-with-client-secret

# ── Admin area (/admin) ─────────────────────────────────────────────────────
# Required to use /admin. At least 12 characters. Keep it secret; changing it signs everyone out.
ADMIN_PASSWORD=replace-with-a-long-random-password

# ── Authenticity serials (/authenticity) ────────────────────────────────────
# Signs the serial number stamped on each piece (A9-<order>-<line>-<check>). Required in Shopify mode for
# verification and for the serials shown on admin order pages. At least 32 random characters, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Independent of the Shopify credentials on purpose. Treat it as permanent: changing it invalidates every
# serial already stamped on a garment.
AUTHENTICITY_SECRET=replace-with-at-least-32-random-characters

# ── Optional tuning ─────────────────────────────────────────────────────────
# Admin API version (default is a stable version pinned in code).
# SHOPIFY_API_VERSION=2026-04
# Per-request timeout in milliseconds (1000-30000, default 10000).
# SHOPIFY_TIMEOUT_MS=10000
# Extra charge for a custom print, in your store's currency (defaults 6 / 9 / 12).
# PRINT_SURCHARGE_SMALL=6
# PRINT_SURCHARGE_MEDIUM=9
# PRINT_SURCHARGE_LARGE=12

# Supabase PostgreSQL (backend/). Use the Session pooler string; percent-encode special characters in the password (@ -> %40).
DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<url-encoded-password>@<region>.pooler.supabase.com:5432/postgres
